# Local dev: copy to .env and fill from Firebase console (Project settings → Your apps → Web app).
# Firebase App Hosting (repo root = app root): build gets FIREBASE_WEBAPP_CONFIG automatically.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe Dashboard (test mode) > Developers > API keys > Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=
